+
+function shortcutGateTranscript(): ScenarioStep[] {
+  return SHORTCUT_GATE_WORDS.map(([role, text, toolName, status], index) => ({
+    at: Math.round((65 + index * 0.25) * 100) / 100,
+    run: (state, now) =>
+      appendTranscript(state, SHORTCUT_GATE_RUN, 'hermes', {
+        at: iso(now),
+        role,
+        text,
+        toolName,
+        model: role === 'assistant' ? NEMOTRON_SUPER : null,
+        status,
+      }),
+  }));
+}

+function shortcutPr(state: DemoState): PullRequestView {
+  const pr = state.snapshot.issues.find((issue) => issue.key === KEYS.shortcut)?.pr;
+  if (!pr) throw new Error(`PR de démo absente : ${KEYS.shortcut}`);
+  return pr;

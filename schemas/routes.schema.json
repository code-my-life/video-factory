{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/code-my-life/video-factory/main/schemas/routes.schema.json",
  "title": "Voies de tournage, version 1",
  "description": "mask/routes.json : pour chaque façon de filmer la prise masquée, la taille de l'image source, la zone utile en 9:16 (sans l'interface) et le miroir à annuler. vf ingest lit la voie de chaque vidéo ici ; la couleur se lit, elle, sur chaque prise.",
  "type": "object",
  "additionalProperties": false,
  "required": ["routes_version", "default", "routes"],
  "properties": {
    "$schema": { "type": "string" },
    "routes_version": { "const": 1 },
    "default": {
      "description": "La voie prise par vf ingest quand aucune n'est nommée.",
      "$ref": "#/$defs/name"
    },
    "routes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": { "$ref": "#/$defs/route" }
    }
  },
  "$defs": {
    "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "size": { "type": "integer", "minimum": 2, "multipleOf": 2 },
    "offset": { "type": "integer", "minimum": 0, "multipleOf": 2 },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["about", "source", "crop", "mirrored"],
      "properties": {
        "about": { "type": "string", "minLength": 1 },
        "source": {
          "description": "Taille de l'image telle qu'elle s'affiche (rotation appliquée), en pixels.",
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": { "width": { "$ref": "#/$defs/size" }, "height": { "$ref": "#/$defs/size" } }
        },
        "crop": {
          "description": "La zone utile, en 9:16, dans l'image source.",
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": { "$ref": "#/$defs/offset" },
            "y": { "$ref": "#/$defs/offset" },
            "width": { "$ref": "#/$defs/size" },
            "height": { "$ref": "#/$defs/size" }
          }
        },
        "mirrored": { "description": "L'image source est en miroir : ingest la remet à l'endroit.", "type": "boolean" },
        "provisional": {
          "description": "Ce qui reste à vérifier sur cette voie, et l'issue qui le vérifie.",
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
